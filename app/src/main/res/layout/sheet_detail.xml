<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detailPane" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingTop="18dp" android:paddingBottom="8dp">
    <TextView android:id="@+id/dKind" android:tag="mute" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingLeft="22dp" android:paddingRight="22dp" android:textSize="13sp"/>
    <TextView android:id="@+id/dTitle" android:tag="ink" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingLeft="22dp" android:paddingRight="22dp" android:layout_marginTop="2dp" android:textSize="28sp" android:textStyle="bold"/>
    <TextView android:id="@+id/dNotes" android:tag="mute" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingLeft="22dp" android:paddingRight="22dp" android:layout_marginTop="8dp" android:textSize="15sp"/>
    <TextView android:id="@+id/dFilesHead" android:tag="ink" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingLeft="22dp" android:paddingRight="22dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:layout_marginTop="8dp" android:text="@string/attached" android:textSize="17sp" android:textStyle="bold"/>
    <LinearLayout android:id="@+id/dFiles" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="22dp" android:paddingRight="22dp" android:paddingTop="2dp" android:paddingBottom="14dp"/>
    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <LinearLayout android:id="@+id/detailRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="22dp" android:paddingRight="22dp" android:paddingTop="14dp" android:paddingBottom="14dp">
        <TextView android:id="@+id/finBtn" android:layout_width="wrap_content" android:layout_height="52dp" android:paddingLeft="32dp" android:paddingRight="32dp" android:background="@drawable/bg_green" android:gravity="center" android:text="@string/finish_work" android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold"/>
        <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
        <TextView android:id="@+id/menuBtn" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_green_circle" android:gravity="center" android:text="≡" android:textColor="#34C759" android:textSize="26sp"/>
    </LinearLayout>
</LinearLayout>
